<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameSir G7 Pro Pairing" Width="960" Height="850" MinWidth="800" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#0D111B" Foreground="#EDF2FC"
        FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#A6B2C9"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EDF2FC"/>
      <Setter Property="Background" Value="#273247"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="Foreground" Value="#172033"/><Setter Property="Background" Value="#F0F3FA"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#171F2F"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="#293247"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="32,28,32,24">
    <Grid Margin="0,0,0,24">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="G7 PRO / PAIRING UTILITY" Foreground="#76D5BB" FontSize="11" FontWeight="Bold"/>
        <TextBlock Text="A new connection." FontSize="32" FontWeight="SemiBold" Margin="0,6,0,6"/>
        <TextBlock Text="Pair your G7 Pro controller with a replacement or existing receiver." Foreground="{StaticResource Muted}"/>
      </StackPanel>
      <Border Grid.Column="1" VerticalAlignment="Top" CornerRadius="5" Background="#202C3A" Padding="10,5" Margin="18,0,0,0"><TextBlock Text="OPEN SOURCE · v0.2.0" FontSize="10" Foreground="#AFC4D9"/></Border>
    </Grid>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="01   Prepare your devices" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,14"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Connect the receiver" FontWeight="SemiBold"/><TextBlock Margin="0,6,0,0" Foreground="{StaticResource Muted}" Text="Plug the receiver into your PC. Disconnect other controllers so you only pair the intended one."/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Enter USB pairing mode" FontWeight="SemiBold"/><TextBlock Margin="0,6,0,0" Foreground="{StaticResource Muted}" Text="Unplug the controller. Set its rear switch to the middle. Hold D-pad Up + Left while plugging USB back in, then release."/></StackPanel>
        </Grid>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <Grid Margin="0,0,0,16"><TextBlock Text="02   Choose your devices" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center"/><Button x:Name="Scan" Content="Scan devices" HorizontalAlignment="Right" Padding="14,8"/></Grid>
        <Grid x:Name="DeviceSelectors">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="RECEIVER" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="Receivers" DisplayMemberPath="Label" AutomationProperties.Name="Receiver"/><TextBlock x:Name="ReceiverInfo" Text="Not detected" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="CONTROLLER TO PAIR" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="Controllers" DisplayMemberPath="Label" AutomationProperties.Name="Controller to pair"/><TextBlock x:Name="ControllerInfo" Text="Not detected" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/></StackPanel>
        </Grid>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="03   Pair and verify" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,10"/>
        <TextBlock Text="This replaces the receiver's current controller pairing. Original addresses are backed up before any change." Foreground="{StaticResource Muted}" Margin="0,0,0,18"/>
        <StackPanel Orientation="Horizontal"><Button x:Name="Pair" Content="Pair devices" Background="#75D9BC" Foreground="#0D241D" MinWidth="154" IsEnabled="False"/><Button x:Name="Read" Content="Read addresses" Margin="10,0,0,0" IsEnabled="False"/></StackPanel>
        <ProgressBar x:Name="Progress" Height="3" Margin="0,18,0,0" Visibility="Collapsed" IsIndeterminate="True" Foreground="#75D9BC" Background="#293247" BorderThickness="0"/>
        <Border x:Name="StatusPanel" Background="#202B40" CornerRadius="7" Padding="14,12" Margin="0,18,0,0"><StackPanel><TextBlock x:Name="StatusTitle" Text="Ready when you are" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="Connect both devices, then choose Scan devices." Foreground="#BCC9DF" FontSize="13" Margin="0,4,0,0"/></StackPanel></Border>
      </StackPanel>
    </Border>
    <Expander x:Name="Details" Header="Technical details &amp; activity" Foreground="{StaticResource Muted}" Margin="0,2,0,16">
      <StackPanel Margin="0,14,0,0"><TextBlock Text="Activity includes USB reports and device addresses. Review it before sharing." FontSize="12" Margin="0,0,0,10"/>
        <TextBox x:Name="Activity" Height="220" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Foreground="#BCC9DF" Background="#111723" BorderBrush="#293247" Padding="12" AutomationProperties.Name="Activity log"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="Copy" Content="Copy activity" Padding="12,7" FontSize="12"/><Button x:Name="OpenLogs" Content="Open backups &amp; logs" Padding="12,7" FontSize="12" Margin="8,0,0,0"/></StackPanel>
      </StackPanel>
    </Expander>
    <Grid><TextBlock Text="Independent community utility. Not affiliated with GameSir." Foreground="#8D9BB4" FontSize="11"/><TextBlock Text="LOCAL USB ONLY · NO TELEMETRY" Foreground="#8D9BB4" FontSize="10" HorizontalAlignment="Right"/></Grid>
  </StackPanel>
  </ScrollViewer>
</Window>
